[Unit]
Description=EasyEffects Auto Preset Switcher and Tray
Documentation=https://github.com/russellmilliner/easyeffects-auto-preset
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Launch Python GUI tray app (or replace with easyeffects-auto-preset-daemon for headless Rust daemon):
ExecStart=%h/.local/bin/easyeffects-auto-preset --minimized
Restart=on-failure
SuccessExitStatus=0 15 SIGTERM SIGKILL
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=graphical-session.target
